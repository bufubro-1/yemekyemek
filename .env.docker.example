# Yalnızca lokal Docker geliştirme ortamı içindir.
# Bu dosyayı .env.docker adıyla kopyala ve gerçek değerleri commit etme.

POSTGRES_DB=yemekyemek
POSTGRES_USER=yemekyemek
POSTGRES_PASSWORD=change_this_local_database_password
POSTGRES_PORT=5432

JWT_SECRET=change_this_to_a_random_secret_with_at_least_32_characters

ADMIN_EMAIL=admin@yemekyemek.local
ADMIN_PASSWORD=change_this_admin_password
ADMIN_NICKNAME=yemekyemek_admin
ADMIN_USERNAME=YemekYemek Admin

BACKEND_PORT=3000
ADMIN_PORT=5173
